rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuário só pode ler/escrever o PRÓPRIO documento de sessão.
    match /sessions/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Bloqueia tudo mais por padrão (ajuste se já tiver outras coleções).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
